# ============================================================
# Planar backend environment variables
# ------------------------------------------------------------
# Copy this to .env and fill in your values.
# .env is git-ignored (listed in .gitignore).
# ============================================================

# --- Postgres (for production / docker) ---
# PLANAR_DB_URL=jdbc:postgresql://localhost:5433/planar
# PLANAR_DB_USERNAME=postgres
# PLANAR_DB_PASSWORD=postgres
# PLANAR_DB_DRIVER=org.postgresql.Driver

# --- SMTP for OTP emails ---
# Uncomment and configure to send real emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
