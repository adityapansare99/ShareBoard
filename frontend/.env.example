# Planar frontend — backend connection
# Single source of truth for where the REST API + WebSocket live.
# Copy this file to `.env` and adjust as needed.

# LOCAL DEV (backend on localhost:8080):
#   Leave VITE_BACKEND_URL UNSET. The app calls same-origin /api & /ws and the
#   Vite dev proxy (vite.config.js) forwards them to http://localhost:8080.
#   Uncomment ONLY to point dev at a non-local backend.
#
# VITE_BACKEND_URL=http://localhost:8080

# PRODUCTION (frontend on a different host than the backend, e.g. Netlify → Railway):
#   Set this at BUILD time (e.g. Netlify env var) to the backend's public origin.
#   The bundled axios client uses it as baseURL and the WS client derives its host.
#
# VITE_BACKEND_URL=https://planar-backend.up.railway.app
